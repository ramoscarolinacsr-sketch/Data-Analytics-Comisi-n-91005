-- DROP TABLE

drop table if EXISTS inventario

-- CREATE TABLE

CREATE TABLE inventario(
    id_producto int IDENTITY (1,1) PRIMARY KEY, -- 
    nombre_producto varchar (100), -- UTILIZO VARCHAR PARA INGRESAR TEXTO CON UN LIMITE DE CIEN CARACTERES PARA AHORRAR MEMORIA
    categoria varchar (50),
    precio_unitario decimal (10,2), -- UTILIZO DECIMAL 10,2 PARA INGRESAR HASTA DIEZ NUMEROS ENTEROS Y DOS DECIMALES
    stock_actual int,
    stock_minimo int,
    fecha_ingreso DATE, -- UTILIZO DATE YA QUE SOLO SE VA A INGRESAR UNA FECHA EXACTA SIN HORAS
    activo TINYINT
)

